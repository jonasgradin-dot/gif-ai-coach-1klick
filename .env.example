# SERVER (Vercel → Settings → Environment Variables). Aldrig i appen.
GROQ_API_KEY=            # gratis nyckel från console.groq.com/keys – ENDA nyckeln som behövs, och bara du lägger in den
ACCESS_CODE=             # valfritt: kod som tränarna anger en gång under Profil (skyddar din gratiskvot)
CHAT_MODEL=              # valfritt, standard openai/gpt-oss-120b

# Firebase (valfritt, molnsynk)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
