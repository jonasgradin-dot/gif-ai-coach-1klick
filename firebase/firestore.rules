rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Varje användare når bara sin egen privata kopia.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Delas med administratören: tränarlista och rapporter (utan ljud/transkribering).
    match /members/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Administratörer: skapas manuellt i Firebase-konsolen (dokument-id = användarens UID). Ingen kan skriva härifrån.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
